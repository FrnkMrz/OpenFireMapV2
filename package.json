{
  "name": "openfiremapv2",
  "version": "0.11.0",
  "description": "OpenFireMapV2 is a personal, non-commercial project focused on learning Git, GitHub, and modern CI/CD workflows, using OpenStreetMap (OSM) data and ideas inspired by the original OpenFireMap.",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run handout:build -- handouts/overlay-leitfaden handouts/feuerwehr-truppkarte handouts/feuerwehr-boegen handouts/feuerwehr-leitfaden handouts/feuerwehr-praesentation handouts/feuerwehr-comic && vite build",
    "preview": "vite preview",
    "test": "vitest test/",
    "test:ci": "vitest run test/",
    "test:coverage": "vitest run test/ --coverage",
    "lint": "eslint src/**/*.js",
    "i18n:check": "node ./scripts/i18n-check.mjs",
    "handout:build": "node ./scripts/build-handout.mjs",
    "help:build": "node ./scripts/build-help.mjs",
    "help:shots": "node ./help/screenshots.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrnkMrz/OpenFireMapV2.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/FrnkMrz/OpenFireMapV2/issues"
  },
  "homepage": "https://github.com/FrnkMrz/OpenFireMapV2#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "marked": "18.2.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.19.0",
    "pbf": "^5.2.0",
    "pmtiles": "^4.5.0"
  }
}
