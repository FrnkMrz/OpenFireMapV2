{
  "name": "openfiremapv2",
  "version": "0.10.1",
  "description": "OpenFireMapV2 is a personal, non-commercial project focused on learning Git, GitHub, and modern CI/CD workflows, using OpenStreetMap (OSM) data and ideas inspired by the original OpenFireMap.",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest test/",
    "test:ci": "vitest run test/",
    "test:coverage": "vitest run test/ --coverage",
    "lint": "eslint src/**/*.js",
    "i18n:check": "node ./scripts/i18n-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrnkMrz/OpenFireMapV2.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/FrnkMrz/OpenFireMapV2/issues"
  },
  "homepage": "https://github.com/FrnkMrz/OpenFireMapV2#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "jspdf": "^4.2.0",
    "leaflet": "^1.9.4",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
